#include <windows.h>

IDI_APP_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/icons/FrameExtractor.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Frame Extractor"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "frame-extractor-gui"
      VALUE "OriginalFilename", "frame-extractor-gui.exe"
      VALUE "ProductName", "Frame Extractor"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "LegalCopyright", "Copyright (c) 2026 M. Seeger"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
